{
  "name": "crowdsenseai",
  "version": "0.1.0",
  "type": "module",
  "description": "CrowdSenseAI - AI-powered location tracking with signal prediction",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:native": "electron . --no-sandbox --disable-setuid-sandbox",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder"
  },
  "keywords": [
    "electron",
    "deck.gl",
    "react",
    "location",
    "crowdsensing",
    "ai"
  ],
  "author": "CrowdSenseAI Team",
  "license": "MIT",
  "dependencies": {
    "@deck.gl/core": "^9.2.11",
    "@deck.gl/layers": "^9.2.11",
    "@deck.gl/react": "^9.2.11",
    "@supabase/supabase-js": "^2.99.3",
    "deck.gl": "^9.2.11",
    "electron-log": "^5.4.3",
    "maplibre-gl": "^5.21.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-map-gl": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.27",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.1.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "build": {
    "appId": "com.crowdsenseai.app",
    "productName": "CrowdSenseAI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "mac": {
      "target": "dmg",
      "entitlements": "resources/crowdsenseai.entitlements",
      "entitlementsInherit": "resources/crowdsenseai.entitlements"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
